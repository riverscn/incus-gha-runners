# incus-gha-runners configuration: one file per pool of runners.
# Copy to /etc/incus-gha-runners/config.env (or pass --config FILE). No secrets go here.
# Every key is described in docs/design.md, section 4.

# ---- the pool ----------------------------------------------------------------
# Repository (https://github.com/OWNER/REPO) or organisation (https://github.com/ORG).
GITHUB_URL=https://github.com/OWNER/REPO
# Comma-separated; GitHub adds self-hosted, linux and x64 itself.
RUNNER_LABELS=ci
# Runners register as <prefix><N>. Default: "<short hostname>-".
#RUNNER_NAME_PREFIX=myhost-
# Organisation runners only.
#RUNNER_GROUP=
# Template <prefix>-tpl, runner containers <prefix>-1, <prefix>-2, …
CONTAINER_PREFIX=ci
# How many runners `add-runner --all`, `status` and `doctor` look at.
RUNNER_COUNT=2
# Runner program version in the template, or latest.
#RUNNER_VERSION=latest
# Per-container limits (Incus limits.cpu / limits.memory). Empty: no limit.
#LIMITS_CPU=4
#LIMITS_MEMORY=4GiB

# ---- template contents --------------------------------------------------------
#DEBIAN_SUITE=trixie
# Extra apt packages for every runner.
#EXTRA_PACKAGES=
# Build cache limit of the dockerd in each container.
#DOCKER_BUILDER_KEEP=3GB
# Project-specific install scripts (*.sh, run as root in file-name order). See docs/operations.md.
#HOOKS_DIR=/etc/incus-gha-runners/hooks.d/ci

# ---- network -----------------------------------------------------------------
# global: images.linuxcontainers.org, deb.debian.org, download.docker.com, no Docker Hub cache.
# cn:     mmdebstrap from a Tsinghua mirror, Tsinghua Debian and Docker mirrors, Docker Hub cache on.
NETWORK_PRESET=global
# Each of these overrides the preset.
#BASE_IMAGE=images                 # images | mmdebstrap
#DEBIAN_MIRROR=https://deb.debian.org/debian
#DEBIAN_SECURITY_MIRROR=https://security.debian.org/debian-security
#HUB_MIRROR=off                    # on | off
#HUB_MIRROR_PORT=5000
#HUB_MIRROR_NAME=hub-mirror
#DOCKER_APT_URL=https://download.docker.com/linux/debian
#RUNNER_DOWNLOAD_URL=https://github.com/actions/runner/releases/download

# ---- host ----------------------------------------------------------------------
#INCUS_BRIDGE=incusbr0
# Default: the interface of the default route.
#UPLINK_IF=eth0
