#!/usr/bin/env bash
# Prepare the host once: Incus, the bridge, forwarding through Docker's firewall, the Docker Hub cache.
# shellcheck source=../lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

usage() {
	cat <<'EOF'
Usage: sudo prepare-host [--config FILE] [--dry-run]

Checks the host (systemd, Incus 6.0 or later), installs Incus (and mmdebstrap when
BASE_IMAGE=mmdebstrap) with apt where it is missing, initialises Incus with a minimal setup
when it is not initialised, and, when needed:
  - allows the Incus bridge through Docker's FORWARD DROP policy (incus-docker-forward.service)
  - starts the Docker Hub pull-through cache on the bridge address (HUB_MIRROR=on)
Both change the host: run with --dry-run first and show the output to whoever owns the host.

Without apt, or with firewalld or Docker's nftables backend, it does not improvise: it lists
what is left to do by hand and exits with 3.
EOF
}

parse_args "--dry-run" -- "$@"
require_root
load_config
take_lock

# Steps the script will not do on this host; listed at the end, exit code 3.
manual=()

echo "== system"
# shellcheck source=/dev/null
. /etc/os-release
if [[ ${ID:-} == debian && ${VERSION_ID:-} == 13 ]]; then
	ok "$PRETTY_NAME (tested)"
else
	warn "${PRETTY_NAME:-unknown system}: not tested, only Debian 13 is (see docs/setup.md, host requirements)"
fi
[[ -d /run/systemd/system ]] || die "the host must run systemd"
ok "systemd"
has_apt=0
command -v apt-get >/dev/null && has_apt=1

echo "== packages"
# command or file -> apt package
declare -A wanted=([incus]=incus)
if [[ $BASE_IMAGE == mmdebstrap ]]; then
	wanted[mmdebstrap]=mmdebstrap
	wanted[/usr/share/keyrings/debian-archive-keyring.gpg]=debian-archive-keyring
fi
missing=()
for what in "${!wanted[@]}"; do
	if [[ $what == /* && -e $what ]] || { [[ $what != /* ]] && command -v "$what" >/dev/null; }; then
		ok "${wanted[$what]} present"
	else
		missing+=("${wanted[$what]}")
	fi
done
if ((${#missing[@]})) && ((has_apt)); then
	run apt-get update
	run env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
elif ((${#missing[@]})); then
	manual+=("install ${missing[*]} with this system's package manager (Incus: https://linuxcontainers.org/incus/docs/main/installing/)$([[ $BASE_IMAGE == mmdebstrap ]] && echo ', or set BASE_IMAGE=images'), then run prepare-host again")
fi

echo "== incus"
if ! command -v incus >/dev/null; then
	step "initialise Incus once it is installed"
elif [[ -n $(incus storage list -f csv 2>/dev/null) ]]; then
	ok "initialised"
	incus network show "$INCUS_BRIDGE" >/dev/null 2>&1 ||
		die "Incus is initialised but has no network $INCUS_BRIDGE; set INCUS_BRIDGE to the bridge in use"
	ok "bridge $INCUS_BRIDGE ($(bridge_ipv4 || echo 'no IPv4'))"
else
	run incus admin init --minimal
	((DRY_RUN)) || ok "bridge $INCUS_BRIDGE ($(bridge_ipv4))"
fi
if command -v incus >/dev/null && ! ((DRY_RUN && ${#missing[@]})); then
	v=$(incus_version)
	version_ge "$v" 6.0 || die "Incus $v is too old; 6.0 or later is needed"
	ok "Incus $v"
fi

echo "== firewall"
unit=/etc/systemd/system/incus-docker-forward.service
if firewalld_active; then
	manual+=("firewalld is active, which these scripts do not handle: let $INCUS_BRIDGE out by hand (see docs/troubleshooting.md)")
elif ! command -v docker >/dev/null || ! command -v iptables >/dev/null; then
	ok "no Docker on the host, nothing to do"
elif [[ $(docker_firewall_backend) != iptables ]]; then
	manual+=("Docker uses the $(docker_firewall_backend) firewall backend, which these scripts do not handle: let $INCUS_BRIDGE out by hand (see docs/troubleshooting.md)")
elif ! iptables -S FORWARD 2>/dev/null | grep -qx -- '-P FORWARD DROP'; then
	ok "FORWARD policy is not DROP, nothing to do"
else
	[[ -n $UPLINK_IF ]] || die "cannot find the uplink interface; set UPLINK_IF"
	rule_out=(DOCKER-USER -i "$INCUS_BRIDGE" -o "$UPLINK_IF" -j ACCEPT)
	# shellcheck disable=SC2054 # RELATED,ESTABLISHED is one argument
	rule_back=(DOCKER-USER -i "$UPLINK_IF" -o "$INCUS_BRIDGE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT)
	if [[ -f $unit ]]; then
		ok "$unit exists"
	else
		write_file "$unit" 0644 <<EOF
[Unit]
Description=Let Incus containers on $INCUS_BRIDGE through Docker's FORWARD DROP policy (incus-gha-runners)
After=docker.service incus.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "iptables -C ${rule_out[*]} 2>/dev/null || iptables -I ${rule_out[*]}"
ExecStart=/bin/sh -c "iptables -C ${rule_back[*]} 2>/dev/null || iptables -I ${rule_back[*]}"

[Install]
WantedBy=multi-user.target
EOF
		run systemctl daemon-reload
	fi
	if systemctl is-enabled --quiet incus-docker-forward.service 2>/dev/null; then
		ok "incus-docker-forward.service enabled"
	else
		run systemctl enable incus-docker-forward.service
	fi
	if iptables -C "${rule_out[@]}" 2>/dev/null && iptables -C "${rule_back[@]}" 2>/dev/null; then
		ok "DOCKER-USER allows $INCUS_BRIDGE <-> $UPLINK_IF"
	else
		run systemctl restart incus-docker-forward.service
	fi
fi

echo "== Docker Hub pull-through cache"
if [[ $HUB_MIRROR == off ]]; then
	ok "HUB_MIRROR=off, nothing to do"
else
	command -v docker >/dev/null || die "HUB_MIRROR=on needs Docker on the host; install it or set HUB_MIRROR=off"
	if ((DRY_RUN)) && ! addr=$(bridge_ipv4); then
		addr='<bridge address>'
	else
		addr=$(bridge_ipv4) || die "$INCUS_BRIDGE has no IPv4 address"
	fi
	running=$(docker inspect -f '{{.State.Running}}' "$HUB_MIRROR_NAME" 2>/dev/null || true)
	case $running in
	true) ok "$HUB_MIRROR_NAME running" ;;
	false) run docker start "$HUB_MIRROR_NAME" ;;
	*)
		run docker run -d --name "$HUB_MIRROR_NAME" --restart unless-stopped \
			-p "$addr:$HUB_MIRROR_PORT:5000" \
			-e REGISTRY_PROXY_REMOTEURL=https://registry-1.docker.io \
			-v "$HUB_MIRROR_NAME:/var/lib/registry" registry:3
		;;
	esac
fi

if ((${#manual[@]})); then
	echo "== left to do by hand"
	for m in "${manual[@]}"; do printf '  todo   %s\n' "$m"; done
fi
if ((DRY_RUN)); then
	echo "dry run: nothing was changed"
elif ((${#manual[@]})); then
	needs_confirmation "the host is not ready: do the steps above, then run prepare-host again"
else
	echo "host ready"
fi
